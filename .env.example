# Put local Worker bindings in ignored .dev.vars and production secrets in
# the Cloudflare secret store. Do not commit real keys.
# API integration test server; never point tests at production.
TEST_URL=http://localhost:5174
# Runtime binding names are DB (D1 / SQLite) and BUCKET (R2 images).
# Hosted owner authentication uses Better Auth sessions in D1.
# Billing is intentionally not connected. No payment secrets are consumed.
# Better Auth production secrets (set these in the host's secret store):
# BETTER_AUTH_SECRET=<random secret>
# BETTER_AUTH_URL=https://your-domain.example
# BETTER_AUTH_API_KEY=<Better Auth Infrastructure API key>
# The Infrastructure email service must be enabled to send verification and
# password-reset messages. Email sign-in requires a verified address.

# Provisioned production build configuration. Do not use preview IDs here.
# CF_WORKER_NAME=<worker-name>
# CF_D1_DATABASE_NAME=<database-name>
# CF_D1_DATABASE_ID=<provisioned-uuid>
# CF_R2_BUCKET_NAME=<bucket-name>
# See PRODUCTION_OPERATIONS.md for release and recovery commands.
